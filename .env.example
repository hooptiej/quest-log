# quest-log install config for scripts/deploy.sh (#165). Copy to .env (gitignored) in the checkout
# and set this install's values. docker compose reads this file too.

# Which compose file this install runs. Required.
#   prod: docker-compose.yml        dev: docker-compose.dev.yml
COMPOSE_FILE=docker-compose.yml

# --- this install's own values (#171): the compose files read these and hold none of their own ---
# The container's own address on your LAN. Required: compose stops with a message if it's missing.
# Pick a free address outside your router's DHCP pool.
QUESTLOG_IP=
# The existing ipvlan/macvlan Docker network that address lives on (default questlog-lan).
#QUESTLOG_LAN_NETWORK=questlog-lan
# Host folders mounted at /app/data (state + write-token) and /app/certs. Default ./data and ./certs
# in the checkout; point them outside it to keep the data apart from the code. Spaces are fine, no quotes.
#QUESTLOG_DATA_DIR=/path/to/quest-log-data/data
#QUESTLOG_CERTS_DIR=/path/to/quest-log-data/certs
# The port the app listens on at that address (default 80), and the .local name in its self-signed cert.
#QUESTLOG_PORT=80
#QUESTLOG_HOSTNAME=questlog.local

# Container name, if it isn't the compose file's (quest-log / quest-log-dev).
#QUESTLOG_CONTAINER=quest-log

# deploy.sh backs up QUESTLOG_DATA_DIR (above) before each deploy; when it's unset it reads the
# folder from the running container's /app/data mount.

# Optional dashboard pulse after a successful deploy. Both must be set, or the pulse is skipped.
# The token file is read on this host and never printed.
#QUESTLOG_DASH_URL=http://dashboard.example
#QUESTLOG_DASH_TOKEN_FILE=/path/to/dash_pulse_token
# Light ids, if they aren't the defaults (questlog for prod, questlog-dev for dev).
#QUESTLOG_DASH_LIGHT=questlog
#QUESTLOG_DASH_LIGHT_DEV=questlog-dev

# Written by deploy.sh on every deploy -- leave them to it:
#   QUESTLOG_TAG  the image tag the container runs (<version>-<sha>)
#   BUILD_SHA, BUILD_DATE  the build stamp baked into that image (shown on /health and the footer)
